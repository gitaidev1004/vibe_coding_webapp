# ch06/05_deployment/Dockerfile.springboot
# Spring Boot 백엔드(ch05/backend_springboot)를 컨테이너 이미지로 빌드하기 위한
# 멀티 스테이지 Dockerfile (빌드 단계와 실행 단계를 분리하여 최종 이미지 크기를 줄인다)
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/target/*.jar app.jar

EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
